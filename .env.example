# ---------------------------------------------------------------------------
# Translation providers. None of these are required: with no keys at all the
# app falls back to the free MyMemory endpoint, which is rate limited but works
# out of the box. Add a key when you want better quality or higher volume.
# The app tries providers in the order listed in src/lib/translate/index.ts.
# ---------------------------------------------------------------------------

# DeepL - best quality for German. Free tier: 500k characters/month.
# Free keys end in ":fx" and the app picks the right endpoint automatically.
DEEPL_API_KEY=

# Google Cloud Translation v2 - broadest language coverage, good Vietnamese.
GOOGLE_TRANSLATE_API_KEY=

# LibreTranslate - self-hosted or public instance, no vendor lock-in.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# MyMemory raises your daily quota if you identify yourself with an email.
MYMEMORY_EMAIL=

# Optional: identify the app to news sites when fetching feeds and articles.
USER_AGENT="PolyglotNewsstand/1.0 (+https://github.com/phudinhm/polyglot-newsstand)"
